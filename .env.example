# ---------------------------------------------------------------------------
# PrimeCoat environment variables
# Copy to .env.local for development. Never commit .env.local.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Supabase (public: safe for the browser, RLS applies) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---
# Canonical origin used for OAuth redirectTo and links inside emails.
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (server only) ---
# Used only by scripts (seeding, RLS verification) and the post-commit
# email-status update. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for migrations/type generation only (scripts, never the app).
# Supabase dashboard → Connect → Session pooler URI (port 5432) with your DB password filled in.
SUPABASE_DB_URL=

# --- Mailgun (server only) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
# Optional. Default https://api.mailgun.net ; use https://api.eu.mailgun.net for EU domains.
MAILGUN_API_BASE_URL=
# Optional support/reply-to address.
MAILGUN_REPLY_TO=
